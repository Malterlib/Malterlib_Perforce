Import "../Core/Lib_Malterlib.MTarget"

%Repository "p4source"
{
	Repository
	{
		Type "External"
	}
}

Import "../../External/p4source/p4.MHeader"

%Group "{Malterlib}/{Lib_Malterlib_Perforce}"
{
	Property
	{
		MalterlibNoShortcuts false
		AddIncludePaths_p4api true
	}
	%Group "Perforce"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Perforce/^*"
		}
		%File "Source/^*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
	%Dependency "Lib_Malterlib_Network"
	{
		Dependency.Indirect true
	}
	%Dependency "Lib_p4api"
	{
		!DocumentationEnabled true
		
		Dependency.Indirect true
	}
	%Dependency "Lib_BoringSSL_decrepit"
	{
		!DocumentationEnabled true

		Dependency.Indirect true
	}
}

Property
{
	MalterlibLibrary_Perforce: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Perforce"
	{
		!!MalterlibLibrary_Perforce true
	}
	MalterlibLibrarySeparate_Lib_Malterlib_Perforce: bool = true
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Perforce: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Perforce true
	}
}

%Group "{Test}/{Malterlib_Perforce}"
{
	Property
	{
	}
}

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Perforce"
	MalterlibTestFiles_Malterlib_Perforce: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
	MalterlibTestDependencies_Malterlib_Perforce: [type(CEntity)] = ["Lib_Malterlib_Perforce"]
	MalterlibTestExtraGroups_Malterlib_Perforce: [string] = ["{Test}/{Malterlib_Perforce}"]
}
